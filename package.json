{
  "name": "blandskron-cl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:html": "html-validate dist/index.html dist/404.html dist/privacidad/index.html dist/terminos/index.html",
    "test": "playwright test",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "check": "npm run format:check && npm run lint && npm run build && npm run validate:html && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "html-validate": "^11.21.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
